{
  "name": "hostelchain",
  "version": "1.0.0",
  "description": "Hostel Room Allocation & Waitlist System on Ethereum (Solidity + Hardhat + React)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "seed:local": "hardhat run scripts/seed.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "frontend": "npm --prefix frontend run dev",
    "frontend:install": "npm --prefix frontend install",
    "setup": "npm install && npm --prefix frontend install"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.17"
  }
}
